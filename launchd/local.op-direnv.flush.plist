<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Drops cached secrets AND the SA token, so the next `cd` into a project asks Touch ID.
     Without --token the cache would simply refill from the still-valid token, silently.

     Install: replace USERNAME below, then
       cp launchd/local.op-direnv.flush.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/local.op-direnv.flush.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.op-direnv.flush</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/bin/op-direnv</string>
    <string>flush</string>
    <string>--token</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/USERNAME/logs/op-direnv-flush.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/logs/op-direnv-flush.log</string>
</dict>
</plist>
